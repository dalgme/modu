# Supabase (서울 리전 ap-northeast-2 고정)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 카카오 알림톡 (비즈엠 또는 솔라피 등 대행사 택1)
# 예: KAKAO_ALIMTALK_PROVIDER=bizmsg | solapi
KAKAO_ALIMTALK_PROVIDER=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_API_SECRET=
KAKAO_ALIMTALK_SENDER_PROFILE=

# 문자발송 — Solapi(솔라피, 구 CoolSMS) v4 · HMAC-SHA256 인증
# SMS(≤90byte)/LMS 자동전환, 발신번호 2개 지원
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER_1=
SOLAPI_SENDER_NUMBER_2=

# 행사별 문자 API 자격증명 봉투암호화 KEK (AES-256-GCM · 64자리 hex 또는 base64 32바이트)
# 미설정 시 행사별 등록은 막히고 위 플랫폼 SOLAPI_* 로만 발송된다. 생성: openssl rand -hex 32
# ⚠ 바꾸면 기존 행사 자격증명은 전부 복호화 불가 → 운영사가 재등록해야 한다.
SMS_KEK=

# AI 멘토 매칭 추천 정성 근거 (Anthropic Claude API). 없으면 객관 점수만으로 추천된다.
ANTHROPIC_API_KEY=

# (레거시) SMS 대체발송 — Solapi 미설정 시 fallback 자리
SMS_FALLBACK_API_KEY=
SMS_FALLBACK_API_SECRET=
SMS_FALLBACK_FROM=

# 이메일 발송(SMTP · nodemailer) — 아래 5개가 모두 설정되면 이메일 알림이 자동 활성화된다.
# (미설정 시 문자·인앱 알림만 발송되고 이메일은 무발송)
# 송신하기 → 넥스트랩 검수요청 메일, 넥스트랩 검수 완료 → 진흥원 승인요청 메일.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Vercel Cron 인증 시크릿 (알림 발송·독촉 크론 보호)
CRON_SECRET=

# 최초 관리자 부트스트랩 토큰 (배포 직후 1회 사용 후 제거)
BOOTSTRAP_TOKEN=

# Playwright 크로미움 경로 (Vercel: @sparticuz/chromium, 로컬: 사전 설치 경로)
CHROMIUM_EXECUTABLE_PATH=

# 배포 화면 스모크 점검 (P34-A · docs/SMOKE-TEST.md) — GitHub Actions 시크릿과 같은 값을 Vercel 에도 넣는다.
# SMOKE_SEED_TOKEN: /api/ops/smoke-seed 인증 토큰(비우면 시드 API 는 403 = 꺼짐). 생성: openssl rand -hex 32
# SMOKE_PASSWORD:   점검 계정 4개(smoke-*@modu.test) 공통 비밀번호(8자 이상). 응답·로그에 노출되지 않는다.
SMOKE_SEED_TOKEN=
SMOKE_PASSWORD=

# OPS_ALERT_PHONES: 화면 오류 문자 알림 추가 수신 번호(콤마 구분, 선택). 플랫폼 관리자 휴대폰은 자동 포함.
OPS_ALERT_PHONES=
